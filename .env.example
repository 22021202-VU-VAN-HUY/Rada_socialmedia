# Talent Radar local configuration

# App/API
APP_ENV=local
BACKEND_URL=http://localhost:8000

# Database
# Local Docker Compose uses PostgreSQL. For quick local-only experiments you can
# switch to sqlite:///data/talent_radar.sqlite3.
DATABASE_URL=postgresql+psycopg://talent_radar:talent_radar@localhost:5432/talent_radar

# Config files
SOURCE_REGISTRY_PATH=config/source_registry.example.yaml
QUERY_PACK_PATH=config/query_pack_vsf.yaml

# Crawl
CRAWL_LOOKBACK_HOURS=24
CRAWL_MAX_POSTS_PER_SOURCE=200
CRAWL_COMMENT_MODE=risk_based
CRAWL_MAX_COMMENTS_PER_POST=100

# AI cost control. Keep rule for no API cost.
AI_PROVIDER=rule
AI_MODEL=gemini-2.5-flash
AI_MAX_ITEMS_PER_RUN=300
AI_MIN_FILTER_SCORE=0.35
AI_DAILY_BUDGET_USD=0.25
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=

# Reports
REPORT_OUTPUT_FORMATS=markdown,csv

# Meta/Facebook OAuth connector.
# Create a Meta app, configure this redirect URI in Facebook Login settings,
# then fill the real values locally. Do not commit real secrets.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8501/
FACEBOOK_GRAPH_API_VERSION=v20.0
FACEBOOK_SCOPES=public_profile
FACEBOOK_DEFAULT_GROUP_URL=https://www.facebook.com/groups/782850425639223/
FACEBOOK_PAGE_ACCESS_TOKEN=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Threads
THREADS_ACCESS_TOKEN=
