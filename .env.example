# Talent Radar local configuration

APP_ENV=local
BACKEND_URL=http://localhost:8000
DATABASE_URL=sqlite:///data/talent_radar.sqlite3
SOURCE_REGISTRY_PATH=config/source_registry.example.yaml

CRAWL_LOOKBACK_HOURS=24
CRAWL_MAX_POSTS_PER_SOURCE=200
CRAWL_MAX_COMMENTS_PER_POST=100
COLLECTION_TIMEZONE=Asia/Ho_Chi_Minh
CRAWL_OUTPUT_DIRECTORY=data/exports
COCCOC_EXECUTABLE_PATH=C:\Program Files\CocCoc\Browser\Application\browser.exe
COCCOC_USER_DATA_DIRECTORY=C:\Users\Admin\AppData\Local\CocCoc\Browser\User Data
COCCOC_CONTROL_USER_DATA_DIRECTORY=data/coccoc_huy_user_data
COCCOC_PROFILE_DIRECTORY=Default
COCCOC_PROFILE_ACCOUNT_NAME=Vũ Văn Huy
COCCOC_REMOTE_DEBUGGING_PORT=9223
BROWSER_HEADLESS=false

AUTH_SESSION_HOURS=168
BACKGROUND_WORKER_ENABLED=true
BACKGROUND_POLL_SECONDS=15

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/connections/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v20.0
FACEBOOK_SCOPES=public_profile

# Optional. Pass -WindowHandle directly to the crawler when more than one
# Coc Coc window is open.
COCCOC_WINDOW_HANDLE=
