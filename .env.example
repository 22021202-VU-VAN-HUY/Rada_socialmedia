# Talent Radar local configuration

# Meta/Facebook OAuth connector.
# Create a Meta app, configure this redirect URI in Facebook Login settings,
# then fill the real values locally. Do not commit real secrets.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8501/
FACEBOOK_GRAPH_API_VERSION=v20.0
FACEBOOK_SCOPES=public_profile
FACEBOOK_DEFAULT_GROUP_URL=https://www.facebook.com/groups/782850425639223/
